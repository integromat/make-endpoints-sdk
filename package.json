{
  "name": "@makehq/endpoints-sdk",
  "version": "0.2.0",
  "description": "Typed SDK for calling Make app endpoints",
  "license": "MIT",
  "homepage": "https://github.com/integromat/make-endpoints-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integromat/make-endpoints-sdk.git"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./apps/*": {
      "import": {
        "types": "./dist/esm/lib/generated/*/_catalog.d.ts",
        "default": "./dist/esm/lib/generated/*/_catalog.js"
      },
      "require": {
        "types": "./dist/cjs/lib/generated/*/_catalog.d.ts",
        "default": "./dist/cjs/lib/generated/*/_catalog.js"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/esm/lib/tools.d.ts",
        "default": "./dist/esm/lib/tools.js"
      },
      "require": {
        "types": "./dist/cjs/lib/tools.d.ts",
        "default": "./dist/cjs/lib/tools.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "apps/*": [
        "./dist/cjs/lib/generated/*/_catalog.d.ts"
      ],
      "tools": [
        "./dist/cjs/lib/tools.d.ts"
      ]
    }
  },
  "bin": {
    "make-endpoints-cli": "./dist/esm/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc",
    "test": "vitest run",
    "check:package": "attw --pack ."
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "peerDependencies": {
    "@makehq/sdk": "^1.6.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@makehq/sdk": "1.6.17",
    "@types/node": "24.13.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  }
}
